{
  "manifest_version": 3,
  "name": "DVIDM Link Helper",
  "version": "0.5.11",
  "description": "Send links and pages to DV Internet Download Manager. Hold Ctrl, Alt, Shift or Insert and click a file to download it.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "offscreen",
    "downloads",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:52137/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send to DVIDM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
